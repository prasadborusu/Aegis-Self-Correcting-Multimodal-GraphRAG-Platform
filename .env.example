# AWS General Configuration
AWS_REGION=ap-south-1
APP_ENV=development

# S3 Storage Configuration
S3_BUCKET_DOCUMENTS=aegis-knowledge-sources-dev
S3_BUCKET_PROCESSED=aegis-processed-artifacts-dev

# DynamoDB Configuration
DYNAMODB_DOCUMENTS_TABLE=aegis_documents_dev
DYNAMODB_CONVERSATIONS_TABLE=aegis_conversations_dev

# Bedrock Configuration
BEDROCK_REGION=ap-south-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GENERATION_MODEL_ID=amazon.nova-lite-v1:0

# OpenSearch Serverless
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=aegis-knowledge-index
OPENSEARCH_VECTOR_DIMENSION=1024
