# ==============================================================================
# AEGIS CONFIGURATION ENVIRONMENT TEMPLATE
# Do NOT commit actual secrets or credentials to version control.
# Copy this file to .env and configure for your environment.
# ==============================================================================

# AWS General Configuration
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
APP_ENV=development
LOG_LEVEL=INFO

# S3 Storage Configuration
S3_BUCKET_DOCUMENTS=aegis-knowledge-sources-dev
S3_BUCKET_PROCESSED=aegis-processed-artifacts-dev

# DynamoDB Configuration
DYNAMODB_DOCUMENTS_TABLE=aegis_documents_dev
DYNAMODB_CONVERSATIONS_TABLE=aegis_conversations_dev
DYNAMODB_EVALUATIONS_TABLE=aegis_evaluations_dev

# Amazon Bedrock Model Configuration
BEDROCK_REGION=ap-south-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GENERATION_MODEL_ID=amazon.nova-pro-v1:0
# Alternative Claude 3.5 Sonnet: anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon OpenSearch Serverless Configuration
OPENSEARCH_ENDPOINT=https://example-collection.ap-south-1.aoss.amazonaws.com
OPENSEARCH_INDEX=aegis-knowledge-index
OPENSEARCH_VECTOR_FIELD=embedding
OPENSEARCH_VECTOR_DIMENSION=1024

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval & Reranking Configuration
RETRIEVAL_TOP_K=20
RERANKING_TOP_K=8

# Grounding & Verification Configuration
GROUNDING_THRESHOLD=0.75
MAX_SELF_CORRECTION_ATTEMPTS=3

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
